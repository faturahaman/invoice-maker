# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the PUBLIC invoice-generation API
# (POST /api/v1/invoice/generate). The dashboard UI at "/" needs NONE of these
# — it renders PDFs entirely in the browser. Only set these if you intend to
# expose/use the HTTP API.
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of accepted API keys (Bearer tokens).
# Generate strong random values, e.g.:  openssl rand -hex 32
# Leave empty to effectively disable the API (all requests get 401).
VALID_API_KEYS=

# Comma-separated allowlist of browser Origins permitted via CORS.
# Use "*" to allow any origin. Server-to-server callers (no Origin header)
# are unaffected either way. Example: https://yourapp.vercel.app
ALLOWED_ORIGINS=
